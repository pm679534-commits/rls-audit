{
  "crons": [
    {"path": "/api/cron/scan-enqueue", "schedule": "0 * * * *"},
    {"path": "/api/cron/scan-worker", "schedule": "* * * * *"},
    {"path": "/api/cron/reverify", "schedule": "0 3 * * *"},
    {"path": "/api/cron/trial-reminders", "schedule": "0 8 * * *"},
    {"path": "/api/cron/retention", "schedule": "0 4 * * *"},
    {"path": "/api/cron/notifications", "schedule": "* * * * *"},
    {"path": "/api/cron/exports", "schedule": "* * * * *"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"},
      {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"}
    ]}
  ]
}
