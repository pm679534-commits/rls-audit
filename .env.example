# Public application configuration
NEXT_PUBLIC_SITE_URL=https://siteguard.example
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=replace-with-paddle-client-token
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Server credentials and job protection
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
CRON_SECRET=replace-with-long-random-secret
ENCRYPTION_MASTER_KEY=replace-with-base64-encoded-32-byte-key
ENCRYPTION_KEY_VERSION=1
# Optional JSON map of old key versions to base64 keys for decrypting existing rows after rotation.
ENCRYPTION_PREVIOUS_KEYS=
RESEND_API_KEY=replace-with-resend-key
EMAIL_FROM=SiteGuard <security@siteguard.example>
PADDLE_API_KEY=replace-with-paddle-api-key
PADDLE_WEBHOOK_SECRET=replace-with-paddle-webhook-secret
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_STARTER_MONTHLY=pri_replace
PADDLE_PRICE_STARTER_ANNUAL=pri_replace
PADDLE_PRICE_PRO_MONTHLY=pri_replace
PADDLE_PRICE_PRO_ANNUAL=pri_replace
PADDLE_PRICE_AGENCY_MONTHLY=pri_replace
PADDLE_PRICE_AGENCY_ANNUAL=pri_replace
TURNSTILE_SECRET_KEY=

# Company details for legal pages and invoices
COMPANY_LEGAL_NAME=Example Company Ltd
COMPANY_ADDRESS=Street, City, Country
COMPANY_EMAIL=legal@siteguard.example
COMPANY_REGISTRATION_NUMBER=
COMPANY_VAT_NUMBER=

# Operations
MAINTENANCE_MODE=false
LOG_LEVEL=info
